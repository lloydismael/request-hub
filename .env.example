# Django / Request Hub local environment
# Copy this file to .env and fill in local/runtime values.
# Never commit .env. Never store application login usernames or passwords here.

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PRIMARY_DOMAIN=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SERVE_MEDIA=false
DJANGO_MEDIA_ROOT=
DJANGO_MEDIA_URL=media/
DJANGO_DEFAULT_FROM_EMAIL=

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Azure Communication Services email
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER=

# Microsoft Graph Outlook draft creation
# Required for creating formatted SQR approval drafts directly in Outlook.
PHILDATA_TENANT_ID=
PHILDATA_CLIENT_ID=
PHILDATA_CLIENT_SECRET=
PHILDATA_DOMAIN=phildata.com
PHILDATA_GRAPH_SCOPE=https://graph.microsoft.com/.default

# Microsoft Graph app registration requirements:
# - Application permission: Mail.ReadWrite
# - Admin consent granted
# - The app must be allowed to access the sender mailbox used by Request Hub users.
