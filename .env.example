DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PRIMARY_DOMAIN=esgrequesthub.dreadops.site
DJANGO_SERVE_MEDIA=True
# Media settings are optional when using the database-backed storage engine.
# Leave them blank to rely solely on in-database files.
DJANGO_MEDIA_ROOT=/home/data/request-hub-media
DJANGO_MEDIA_URL=/media/
DB_NAME=postgres
DB_USER=admin123
DB_PASSWORD=@Password123
DB_HOST=requesthub-postgre.postgres.database.azure.com
DB_PORT=5432

